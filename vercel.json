{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "routes": [
    { "src": "^/(server|docs|extension)([./].*)?$", "status": 404 },
    { "src": "^/(package|vercel)\\.json$", "status": 404 },
    { "src": "^/\\.[^/]+$", "status": 404 },
    { "handle": "filesystem" },
    { "src": "^/analyze$", "dest": "/api" },
    { "src": "^/api/analyze$", "dest": "/api" },
    { "src": "^/health$", "dest": "/api" },
    { "src": "^/api/health$", "dest": "/api" }
  ]
}
