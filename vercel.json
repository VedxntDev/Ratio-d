{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "^/(server|docs|extension)([./].*)?$", "status": 404 },
    { "src": "^/(package|vercel)\\.json$", "status": 404 },
    { "src": "^/\\.[^/]+$", "status": 404 },
    { "src": "^/ratiod-(extension|full-project)\\.zip$", "check": true },
    { "handle": "filesystem" },
    {
      "src": "^/ratiod-(extension|full-project)\\.zip$",
      "headers": {
        "Content-Type": "application/zip",
        "Content-Disposition": "attachment"
      },
      "continue": true
    },
    { "src": "^/analyze$", "dest": "/api" },
    { "src": "^/api/analyze$", "dest": "/api" },
    { "src": "^/analyze-qr$", "dest": "/api" },
    { "src": "^/api/analyze-qr$", "dest": "/api" },
    { "src": "^/unmask$", "dest": "/api" },
    { "src": "^/api/unmask$", "dest": "/api" },
    { "src": "^/health$", "dest": "/api" },
    { "src": "^/api/health$", "dest": "/api" }
  ]
}
